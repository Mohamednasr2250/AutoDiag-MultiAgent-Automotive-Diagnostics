# HuggingFace — LLM (flan-t5-base) + embeddings (all-MiniLM-L6-v2)
HF_API_KEY=your_huggingface_token_here

# Pinecone — vector database
PINECONE_API_KEY=your_pinecone_key_here
PINECONE_INDEX=autodiag

# MLflow — experiment tracking
MLFLOW_TRACKING_URI=http://localhost:5000

# API auth for /admin endpoints
API_KEYS=dev-key-123

# Environment: development | production
ENV=development

# Redis (used in docker-compose for caching + rate limit storage)
REDIS_URL=redis://localhost:6379

# Grafana admin password (docker-compose only)
GRAFANA_PASSWORD=admin

# SQLite path override (optional — defaults to autodiag.db)
DB_PATH=autodiag.db